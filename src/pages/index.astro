---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteProfile } from '../config/site';
import { getAllPosts, getAllWorks } from '../lib/content';
import { personSchema, websiteSchema } from '../lib/schema';

// 构建时复用完整列表的排序，内容更新后首页自动展示各自前 3 条。
const featuredWorks = getAllWorks().slice(0, 3);
const featuredPosts = getAllPosts().slice(0, 3);
---

<BaseLayout
  title="Bing - 让 AI 能力进入真实系统"
  description={siteProfile.description}
  jsonLd={[personSchema(), websiteSchema()]}
>
  <section class="home-hero">
    <p class="eyebrow">Think · Build · Deliver</p>
    <h1>I'm Bing.</h1>
    <p class="hero-statement">{siteProfile.statement}</p>
    <div class="hero-introduction">
      {siteProfile.introduction.map((line) => <p class="lead">{line}</p>)}
    </div>
    <!-- 项目入口与下方栏目统一用“项目”命名，帮助读者识别跳转内容。 -->
    <div class="hero-actions" aria-label="主要入口">
      <a class="text-link" href="/works/">查看项目</a>
      <a class="text-link" href="/blog/">阅读文章</a>
    </div>
  </section>

  <section class="page-section home-section" aria-labelledby="capabilities-heading">
    <div class="section-heading">
      <h2 id="capabilities-heading">我关注的事情</h2>
    </div>
    <ul class="capability-list">
      {siteProfile.capabilities.map((capability) => (
        <li class="capability-item">
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="page-section home-section" aria-labelledby="work-heading">
    <div class="section-heading">
      <h2 id="work-heading">我的项目</h2>
      <a href="/works/">全部项目</a>
    </div>
    <ol class="work-list">
      {featuredWorks.map((work) => (
        <li class="work-row">
          <div>
            <h3 class="row-title"><a href={`/works/${work.id}/`}>{work.title}</a></h3>
            <p class="row-description">{work.subtitle}</p>
          </div>
          <p class="row-description">{work.description}</p>
          <span class="row-meta">{work.focus?.slice(0, 2).join(' · ') || work.category}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-section home-section" aria-labelledby="writing-heading">
    <div class="section-heading">
      <!-- 与“我的项目”保持一致，并与“全部文章”入口统一内容称谓。 -->
      <h2 id="writing-heading">我的文章</h2>
      <a href="/blog/">全部文章</a>
    </div>
    <ol class="post-list">
      {featuredPosts.map((post) => (
        <li class="post-row">
          <div>
            <h3 class="row-title"><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
            <p class="row-description">{post.excerpt}</p>
          </div>
          <span class="row-topic">{post.topic}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-section home-section" aria-labelledby="principles-heading">
    <div class="section-heading">
      <h2 id="principles-heading">判断与原则</h2>
    </div>
    <ol class="principle-list">
      {siteProfile.principles.map((principle) => <li>{principle}</li>)}
    </ol>
  </section>
</BaseLayout>
