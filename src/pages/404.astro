---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面未找到 | Bing"
  description="这个地址没有对应的页面。"
  noindex
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>页面未找到</h1>
    <p class="lead">这个地址没有对应内容，可以返回首页继续浏览。</p>
    <a class="text-link" href="/">返回首页</a>
  </section>
</BaseLayout>

