---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_URL, siteProfile } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = siteProfile.description,
  image,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, `${SITE_URL}/`).toString();
const socialImage = image ? new URL(image, `${SITE_URL}/`).toString() : undefined;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('bing-theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (systemDark ? 'dark' : 'light');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteProfile.name} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#f7f8f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111514" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Bing Writing" href="/rss.xml" />
    <meta property="og:site_name" content={siteProfile.siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
    ))}
    <script is:inline>
      (() => {
        const hash = location.hash;
        if (hash === '#/blog') location.replace('/blog/');
        if (hash.startsWith('#/blog/')) location.replace(`/blog/${hash.slice(7).replace(/\/$/, '')}/`);
        if (hash === '#/' || hash === '#/works') history.replaceState(null, '', '/');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="page-frame">
      <SiteHeader />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
