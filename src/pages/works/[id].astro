---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllWorks, type Work } from '../../lib/content';
import { breadcrumbSchema, workSchema } from '../../lib/schema';

export function getStaticPaths() {
  return getAllWorks().map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

interface Props {
  work: Work;
}

const { work } = Astro.props;
const relatedPosts = getAllPosts().filter((post) => work.relatedPosts?.includes(post.slug));
const caseStudy = work.caseStudy;
---

<BaseLayout
  title={`${work.title} - ${work.subtitle} | Bing`}
  description={work.description}
  image={work.thumb}
  jsonLd={[
    workSchema(work),
    breadcrumbSchema([
      { name: '首页', path: '/' },
      { name: 'Work', path: '/works/' },
      { name: work.title, path: `/works/${work.id}/` },
    ]),
  ]}
>
  <header class="project-heading">
    <p class="eyebrow">{work.category} · {work.author}{work.year ? ` · ${work.year}` : ''}</p>
    <h1>{work.title}</h1>
    <p class="project-subtitle">{work.subtitle}</p>
    <p class="lead">{work.description}</p>
    <div class="project-actions">
      {work.links.demo && <a class="text-link" href={work.links.demo} target="_blank" rel="noopener noreferrer">访问项目</a>}
      {work.links.source && <a class="text-link" href={work.links.source} target="_blank" rel="noopener noreferrer">查看源码</a>}
    </div>
  </header>

  <figure class="project-visual">
    <img src={work.thumb} alt={`${work.title} 项目视觉`} width="1280" height="720" />
  </figure>

  {work.focus && (
    <section class="project-section" aria-labelledby="focus-heading">
      <h2 id="focus-heading">关注点</h2>
      <ul class="detail-list detail-list--inline">
        {work.focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )}

  {caseStudy ? (
    <>
      {caseStudy.background && (
        <section class="project-section prose-section">
          <h2>背景与问题</h2>
          <p>{caseStudy.background}</p>
        </section>
      )}

      {caseStudy.role && (
        <section class="project-section prose-section">
          <h2>我的职责</h2>
          <p>{caseStudy.role}</p>
        </section>
      )}

      {caseStudy.constraints && (
        <section class="project-section">
          <h2>约束与关键判断</h2>
          <ul class="detail-list">
            {caseStudy.constraints.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {caseStudy.decisions && (
        <section class="project-section">
          <h2>架构决策</h2>
          <ol class="decision-list">
            {caseStudy.decisions.map((item) => <li>{item}</li>)}
          </ol>
        </section>
      )}

      {caseStudy.implementation && (
        <section class="project-section">
          <h2>工程实现</h2>
          <ul class="detail-list">
            {caseStudy.implementation.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {(caseStudy.delivery || caseStudy.reflection) && (
        <section class="project-section project-conclusion">
          {caseStudy.delivery && <div><h2>交付方式</h2><p>{caseStudy.delivery}</p></div>}
          {caseStudy.reflection && <div><h2>复盘</h2><p>{caseStudy.reflection}</p></div>}
        </section>
      )}
    </>
  ) : (
    <section class="project-section prose-section">
      <h2>项目概述</h2>
      <p>{work.description}</p>
      <p>这个页面记录项目定位与公开入口。更完整的架构判断和实现复盘会随着项目演进持续补充。</p>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="project-section" aria-labelledby="related-writing-heading">
      <h2 id="related-writing-heading">相关写作</h2>
      <ol class="related-list">
        {relatedPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>{post.title}</a>
            <span>{post.topic} · {post.readingMinutes} 分钟</span>
          </li>
        ))}
      </ol>
    </section>
  )}
</BaseLayout>
